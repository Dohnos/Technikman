---
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { pageCities } from '../data/regions';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo inverse />
      <p>Nezávislá prověrka ojetých aut před koupí. Olomouc a celá Morava.</p>
    </div>
    <div>
      <p class="footer__title">Kontakt</p>
      <ul>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.hours}</li>
        <li><a href={withBase('/#rezervace')}>Rezervovat termín</a></li>
      </ul>
    </div>
    <nav aria-label="Prověrka auta podle města">
      <p class="footer__title">Prověrka auta</p>
      <ul class="footer__cities">
        {pageCities.map((c) => <li><a href={withBase(`/proverka-auta/${c.slug}/`)}>{c.name}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {site.name}</span>
    <span>v{site.version} · <a href={withBase('/brand/')}>Brand manuál</a></span>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: #b9bdc3;
    padding-block: 56px 24px;
    font-size: 0.95rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.3fr;
    gap: 2.5rem;
  }
  .footer__brand p {
    margin-top: 0.9rem;
    max-width: 20rem;
  }
  .footer__title {
    color: #fff;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .footer ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .footer__cities {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .footer a {
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>

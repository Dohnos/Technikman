---
import Icon from './Icon.astro';
import { site, plans } from '../data/site';

interface Props {
  city?: string;
}
const { city = '' } = Astro.props;
---

<section class="section contact" id="objednat">
  <div class="container">
    <div class="contact__box" data-reveal="zoom">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="contact__copy">
        <span class="eyebrow">Objednat prověrku</span>
        <h2 class="h2">Našli jste auto? <span class="hl">Pošlete nám ho.</span></h2>
        <p class="lead">Ozveme se do pár hodin, domluvíme termín s prodejcem a auto proklepneme.</p>
        <div class="contact__direct">
          <a class="direct" href={site.phoneHref}>
            <span class="direct__icon"><Icon name="phone" size={22} /></span>
            <span><small>Zavolejte</small><b>{site.phone}</b></span>
          </a>
          <a class="direct" href={`mailto:${site.email}`}>
            <span class="direct__icon"><Icon name="mail" size={22} /></span>
            <span><small>Napište</small><b>{site.email}</b></span>
          </a>
          <div class="direct">
            <span class="direct__icon"><Icon name="clock" size={22} /></span>
            <span><small>Kdy jsme k zastižení</small><b>{site.hours}</b></span>
          </div>
        </div>
      </div>

      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain" data-order-form>
        <div class="field">
          <label for="f-name">Jméno</label>
          <input id="f-name" name="jmeno" autocomplete="name" required placeholder="Jan Novák" />
        </div>
        <div class="field">
          <label for="f-phone">Telefon</label>
          <input id="f-phone" name="telefon" type="tel" autocomplete="tel" required placeholder="+420 …" />
        </div>
        <div class="field field--full">
          <label for="f-link">Odkaz na inzerát</label>
          <input id="f-link" name="inzerat" type="url" inputmode="url" placeholder="https://…" />
        </div>
        <div class="field">
          <label for="f-plan">Služba</label>
          <select id="f-plan" name="sluzba">
            {plans.map((p) => <option value={p.name} selected={p.featured}>{p.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-city">Kde auto stojí</label>
          <input id="f-city" name="lokalita" value={city} placeholder="Olomouc" />
        </div>
        <div class="field field--full">
          <label for="f-note">Poznámka</label>
          <textarea id="f-note" name="poznamka" rows="3" placeholder="Na co se máme zaměřit?"></textarea>
        </div>
        <button class="btn btn--brand btn--lg btn--block field--full" type="submit">
          Odeslat poptávku <Icon name="arrow" size={20} class="icon-arrow" />
        </button>
        <p class="form__note field--full" data-form-note>Odesláním otevřete e-mail s vyplněnou poptávkou. Údaje použijeme jen k domluvě prověrky.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .contact__box {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--r-xl);
    background: var(--night);
    color: #e8ecf4;
    overflow: hidden;
    isolation: isolate;
  }
  .contact__glow {
    position: absolute;
    z-index: -1;
    width: 600px;
    height: 600px;
    left: -200px;
    bottom: -300px;
    background: radial-gradient(circle, rgb(255 90 31 / 0.28), transparent 60%);
  }
  .contact__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }
  .contact h2 {
    color: #fff;
  }
  .contact .eyebrow {
    background: rgb(255 90 31 / 0.14);
    color: #ff8a5c;
  }
  .contact .lead {
    color: #a9b3c6;
  }
  .contact__direct {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .direct {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: #fff;
  }
  .direct small {
    display: block;
    color: #a9b3c6;
    font-size: 0.82rem;
  }
  .direct b {
    font-size: 1.1rem;
    font-weight: 650;
  }
  .direct__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.07);
    color: var(--brand);
    transition:
      transform 0.45s var(--ease-spring),
      background-color 0.3s,
      color 0.3s;
  }
  a.direct:hover .direct__icon {
    background: var(--brand);
    color: #fff;
    transform: rotate(-8deg) scale(1.06);
  }
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--ink);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--brand);
    background: #fff;
    box-shadow: 0 0 0 4px var(--brand-50);
  }
  .form__note {
    font-size: 0.82rem;
    color: var(--muted);
    text-align: center;
  }
  .form__note.is-ok {
    color: var(--ok-600);
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .contact__box {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Poptávka -> předvyplněný e-mail (bez backendu, funguje na statickém hostingu).
  document.querySelectorAll<HTMLFormElement>('[data-order-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const subject = `Poptávka prověrky: ${get('sluzba')}${get('lokalita') ? ' – ' + get('lokalita') : ''}`;
      const body = [
        `Jméno: ${get('jmeno')}`,
        `Telefon: ${get('telefon')}`,
        `Služba: ${get('sluzba')}`,
        `Lokalita vozu: ${get('lokalita')}`,
        `Inzerát: ${get('inzerat')}`,
        '',
        get('poznamka'),
      ].join('\n');
      const to = form.action.replace(/^mailto:/, '');
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const note = form.querySelector('[data-form-note]');
      if (note) {
        note.textContent = 'Díky! Otevřel se vám e-mail s poptávkou, stačí ho odeslat.';
        note.classList.add('is-ok');
      }
    });
  });

  // Tlačítka v ceníku předvyplní službu
  document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach((a) => {
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#f-plan');
      const name = a.closest('.plan')?.querySelector('h3')?.textContent?.trim();
      if (select && name) select.value = name;
    });
  });
</script>

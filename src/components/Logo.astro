---
import { withBase } from '../lib/paths';
import LogoMark from './LogoMark.astro';
interface Props {
  href?: string;
  inverse?: boolean;
  size?: number;
}
const { href = withBase('/'), inverse = false, size = 34 } = Astro.props;
---

<a href={href} class:list={['logo', { 'logo--inverse': inverse }]} aria-label="Proklepto – úvodní stránka">
  <LogoMark size={size} variant={inverse ? 'light' : 'default'} />
  <span class="logo__word">proklepto</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo--inverse {
    color: #fff;
  }
  .logo__word {
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.045em;
    line-height: 1;
  }
</style>

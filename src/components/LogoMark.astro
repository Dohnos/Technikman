---
// Značka Proklepto: písmeno „P“, jehož bříško tvoří lupa s fajfkou.
interface Props {
  size?: number;
  variant?: 'default' | 'light';
  class?: string;
}
const { size = 36, variant = 'default', class: className } = Astro.props;
const bg = variant === 'light' ? '#FFFFFF' : '#16181B';
const tick = variant === 'light' ? '#16181B' : '#FFFFFF';
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width={size} height={size} class:list={['logo-mark', className]} aria-hidden="true">
  <rect width="64" height="64" rx="14" fill={bg}></rect>
  <path d="M21 26.5V49" stroke="#E0531F" stroke-width="6.5" stroke-linecap="round" fill="none"></path>
  <circle cx="33.5" cy="26.5" r="12.5" stroke="#E0531F" stroke-width="6.5" fill="none"></circle>
  <path d="M27.6 26.8l4.2 4.2 7.4-8.2" stroke={tick} stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
</svg>

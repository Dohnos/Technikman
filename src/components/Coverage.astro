---
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import { cities, regions, pageCities } from '../data/regions';
import { site } from '../data/site';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// Jednoduchá ekvidistantní projekce kolem Olomouce (1° šířky ≈ 300 px)
const K = 300;
const COS = Math.cos((49.6 * Math.PI) / 180);
const project = (lat: number, lon: number) => ({
  x: Math.round(((lon - 16.3) * K * COS + 40) * 10) / 10,
  y: Math.round(((50.35 - lat) * K + 20) * 10) / 10,
});
const base = project(site.baseGeo.lat, site.baseGeo.lon);
const pxPerKm = K / 111;
const rings = [25, 50, 100];

const dots = cities.map((c) => ({ ...c, ...project(c.lat, c.lon), main: c.region === regions.olomoucky }));
---

<section class="section coverage" id="kde-pusobime">
  <div class="container coverage__grid">
    <div class="coverage__copy" data-reveal="left">
      <span class="eyebrow">Kde působíme</span>
      <h2 class="h2">Doma v <span class="hl">Olomouckém kraji.</span> Jezdíme po celé Moravě.</h2>
      <p class="lead">
        Základnu máme v Olomouci. Pravidelně vyjíždíme do Jihomoravského, Zlínského i Moravskoslezského kraje. Po domluvě kamkoli v Česku.
      </p>
      <ul class="regions">
        {Object.values(regions).map((r, i) => (
          <li class:list={{ main: i === 0 }}>
            <Icon name="pin" size={18} />{r}
          </li>
        ))}
      </ul>
      <nav class="city-links" aria-label="Prověrka auta ve městech">
        {pageCities.map((c) => (
          <a href={withBase(`/proverka-auta/${c.slug}/`)} class:list={{ active: c.slug === active }}>
            {c.name}
          </a>
        ))}
      </nav>
    </div>

    <div class="map" data-reveal="zoom" data-scene>
      <svg viewBox="0 0 460 440" role="img" aria-label="Mapa působnosti Proklepto s centrem v Olomouci">
        <defs>
          <radialGradient id="sweep" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform={`translate(${base.x} ${base.y}) scale(280)`}>
            <stop offset="0" stop-color="#FF5A1F" stop-opacity=".35"></stop>
            <stop offset="1" stop-color="#FF5A1F" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect width="460" height="440" rx="36" fill="#0B1220"></rect>
        <g stroke="#fff" stroke-opacity=".05">
          {Array.from({ length: 11 }, (_, i) => <path d={`M${i * 46} 0v440M0 ${i * 44}h460`}></path>)}
        </g>
        {rings.map((km) => (
          <g>
            <circle cx={base.x} cy={base.y} r={km * pxPerKm} fill="none" stroke="#fff" stroke-opacity=".12" stroke-dasharray="4 6"></circle>
            <text x={base.x + 6} y={base.y - km * pxPerKm - 6} fill="#fff" fill-opacity=".4" font-size="11">{km} km</text>
          </g>
        ))}
        <circle cx={base.x} cy={base.y} r={25 * pxPerKm} fill="#FF5A1F" fill-opacity=".1"></circle>
        <g class="map__sweep" style={`transform-origin:${base.x}px ${base.y}px`}>
          <path d={`M${base.x} ${base.y}L${base.x + 280} ${base.y}A280 280 0 0 0 ${base.x + 280 * Math.cos(-0.7)} ${base.y + 280 * Math.sin(-0.7)}Z`} fill="url(#sweep)"></path>
        </g>
        {dots.filter((d) => d.slug !== 'olomouc').map((d) => (
          <path d={`M${base.x} ${base.y}L${d.x} ${d.y}`} stroke={d.main ? '#FF5A1F' : '#17C98A'} stroke-opacity=".28" stroke-width="1.5" class="map__route"></path>
        ))}
        {dots.map((d, i) => {
          const isBase = d.slug === 'olomouc';
          const right = d.x < 360 && !['prostejov', 'litovel'].includes(d.slug);
          const label = (
            <text x={right ? d.x + 12 : d.x - 12} y={d.y + 4} text-anchor={right ? 'start' : 'end'} fill="#fff" fill-opacity={isBase || d.page ? 0.95 : 0.55} font-size={isBase ? 15 : 12} font-weight={isBase ? 700 : 550}>
              {d.name}
            </text>
          );
          const dot = (
            <g class="map__dot" style={`--i:${i}`}>
              {isBase && <circle class="map__pulse" cx={d.x} cy={d.y} r="10" fill="#FF5A1F"></circle>}
              <circle cx={d.x} cy={d.y} r={isBase ? 8 : d.page ? 5 : 3.5} fill={isBase ? '#FF5A1F' : d.main ? '#FF8A5C' : '#17C98A'} stroke={d.slug === active ? '#fff' : 'none'} stroke-width="2.5"></circle>
              {label}
            </g>
          );
          return d.page ? <a href={withBase(`/proverka-auta/${d.slug}/`)} aria-label={`Prověrka auta ${d.locative}`}>{dot}</a> : dot;
        })}
      </svg>
      <div class="map__legend">
        <span><i style="background:#FF8A5C"></i>Olomoucký kraj</span>
        <span><i style="background:#17C98A"></i>Další kraje</span>
      </div>
    </div>
  </div>
</section>

<style>
  .coverage__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .coverage__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .regions {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    width: 100%;
  }
  .regions li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    font-weight: 550;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
  }
  .regions .icon {
    color: var(--ok);
    flex-shrink: 0;
  }
  .regions li.main {
    background: var(--ink);
    color: #fff;
  }
  .regions li.main .icon {
    color: var(--brand);
  }
  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .city-links a {
    padding: 0.4rem 0.8rem;
    border-radius: var(--pill);
    border: 1.5px solid var(--line);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--ink-2);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s;
  }
  .city-links a:hover,
  .city-links a.active {
    border-color: var(--brand);
    background: var(--brand);
    color: #fff;
  }
  .map {
    position: relative;
  }
  .map svg {
    width: 100%;
    height: auto;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
  }
  .map a {
    cursor: pointer;
  }
  .map a:hover text {
    fill: #ff8a5c;
    fill-opacity: 1;
  }
  .map__sweep {
    animation: spin 5s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(-360deg);
    }
  }
  .map__pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .map__route {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    transition: stroke-dashoffset 2s var(--ease-out);
  }
  .map.seen .map__route,
  :global(html:not(.js)) .map__route {
    stroke-dashoffset: 0;
  }
  .map__dot {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 70ms + 300ms);
  }
  .map.seen .map__dot,
  :global(html:not(.js)) .map__dot {
    opacity: 1;
  }
  .map:not(.in-view) * {
    animation-play-state: paused;
  }
  .map__legend {
    position: absolute;
    left: 1.25rem;
    bottom: 1.1rem;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: #cfd6e4;
  }
  .map__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .map__legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  @media (max-width: 960px) {
    .coverage__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .regions {
      grid-template-columns: 1fr;
    }
  }
</style>

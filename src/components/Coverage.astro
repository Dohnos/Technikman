---
import { withBase } from '../lib/paths';
import { cities, regions, pageCities } from '../data/regions';
import { site } from '../data/site';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// Jednoduchá ekvidistantní projekce kolem Olomouce (1° šířky ≈ 300 px)
const K = 300;
const COS = Math.cos((49.6 * Math.PI) / 180);
const project = (lat: number, lon: number) => ({
  x: Math.round(((lon - 16.3) * K * COS + 40) * 10) / 10,
  y: Math.round(((50.35 - lat) * K + 20) * 10) / 10,
});
const base = project(site.baseGeo.lat, site.baseGeo.lon);
const pxPerKm = K / 111;
const rings = [25, 50, 100];
const dots = cities.map((c) => ({ ...c, ...project(c.lat, c.lon), main: c.region === regions.olomoucky }));
const grouped = Object.values(regions).map((r) => ({ region: r, cities: pageCities.filter((c) => c.region === r) }));
---

<section class="section" id="kde-jezdim">
  <div class="container coverage">
    <div>
      <div class="section-head">
        <p class="label">Kde jezdím</p>
        <h2 class="h2">Olomoucký kraj a celá Morava</h2>
        <p class="lead">Základnu mám v Olomouci. Do {site.freeRadiusKm} km jezdím zdarma, dál za {site.pricePerKm} Kč/km.</p>
      </div>
      <div class="regions">
        {grouped.map((g) => g.cities.length > 0 && (
          <div class="region">
            <h3>{g.region}</h3>
            <ul>
              {g.cities.map((c) => (
                <li><a href={withBase(`/proverka-auta/${c.slug}/`)} aria-current={c.slug === active ? 'page' : undefined}>{c.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <figure class="map" data-reveal>
      <svg viewBox="0 0 460 440" role="img" aria-label="Mapa míst, kam jezdím, s centrem v Olomouci">
        <rect width="460" height="440" fill="#FFFFFF"></rect>
        {rings.map((km) => (
          <g>
            <circle cx={base.x} cy={base.y} r={km * pxPerKm} fill="none" stroke="#D2CFC8" stroke-dasharray="3 5"></circle>
            <text x={base.x + 5} y={base.y - km * pxPerKm - 5} fill="#8A8E94" font-size="11">{km} km</text>
          </g>
        ))}
        <circle cx={base.x} cy={base.y} r={site.freeRadiusKm * pxPerKm} fill="#E0531F" fill-opacity=".07"></circle>
        {dots.filter((d) => d.slug !== 'olomouc').map((d) => (
          <path d={`M${base.x} ${base.y}L${d.x} ${d.y}`} stroke="#D2CFC8" stroke-width="1"></path>
        ))}
        {dots.map((d) => {
          const isBase = d.slug === 'olomouc';
          const right = d.x < 360 && !['prostejov', 'litovel'].includes(d.slug);
          const dot = (
            <g>
              <circle cx={d.x} cy={d.y} r={isBase ? 7 : d.page ? 4.5 : 3} fill={isBase ? '#E0531F' : d.main ? '#16181B' : '#8A8E94'} stroke={d.slug === active ? '#E0531F' : 'none'} stroke-width="3"></circle>
              <text x={right ? d.x + 10 : d.x - 10} y={d.y + 4} text-anchor={right ? 'start' : 'end'} fill={d.page || isBase ? '#16181B' : '#8A8E94'} font-size={isBase ? 14 : 12} font-weight={isBase ? 700 : d.page ? 600 : 400}>{d.name}</text>
            </g>
          );
          return d.page ? <a href={withBase(`/proverka-auta/${d.slug}/`)} aria-label={`Prověrka auta ${d.locative}`}>{dot}</a> : dot;
        })}
      </svg>
      <figcaption>
        <span><i class="k-base"></i>Základna</span>
        <span><i class="k-main"></i>Olomoucký kraj</span>
        <span><i class="k-other"></i>Další kraje</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .coverage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .regions {
    display: grid;
    gap: 1.1rem;
  }
  .region {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .region h3 {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    font-stretch: 100%;
    color: var(--muted);
    margin-bottom: 0.3rem;
    letter-spacing: 0;
  }
  .region ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    list-style: none;
    padding: 0;
  }
  .region a {
    font-weight: 550;
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }
  .region a:hover,
  .region a[aria-current='page'] {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }
  .map {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
  }
  .map svg {
    width: 100%;
    height: auto;
  }
  .map a:hover text {
    fill: var(--accent-ink);
  }
  .map figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .map figcaption span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .map figcaption i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .k-base {
    background: var(--accent);
  }
  .k-main {
    background: var(--ink);
  }
  .k-other {
    background: #8a8e94;
  }
  @media (max-width: 900px) {
    .coverage {
      grid-template-columns: 1fr;
    }
  }
</style>

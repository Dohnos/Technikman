---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';

const items = [
  {
    icon: 'user',
    title: '100% nezávislí',
    text: 'Neprodáváme auta a nebereme provize od bazarů. Hrajeme jen za vás.',
  },
  {
    icon: 'clock',
    title: 'Rychle',
    text: 'Termín obvykle do 48 hodin. Dobrá auta na trhu dlouho nečekají.',
  },
  {
    icon: 'file',
    title: 'Lidskou řečí',
    text: 'Protokol s fotkami a jasným doporučením. Bez technické hantýrky.',
  },
  {
    icon: 'tag',
    title: 'Argumenty na slevu',
    text: 'Každá nalezená vada je důvod ke slevě. Prověrka se často zaplatí sama.',
  },
];
---

<section class="section section--night why">
  <div class="why__glow" aria-hidden="true"></div>
  <div class="container why__grid">
    <div class="why__intro" data-reveal="left">
      <span class="eyebrow">Proč Proklepto</span>
      <h2 class="h2">Na vaší straně. <span class="hl">Vždycky.</span></h2>
      <p class="lead">Nejsme prodejce ani bazar. Jsme technik, který vám řekne pravdu, i když to znamená „tohle auto nekupujte“.</p>
      <div class="why__badge" data-scene>
        <LogoMark size={88} variant="light" />
        <svg class="why__ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="ring-path" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"></path></defs>
          <text><textPath href="#ring-path" textLength="486" lengthAdjust="spacing">NEZÁVISLÁ PROVĚRKA · BEZ PROVIZÍ · PROKLEPTO · </textPath></text>
        </svg>
      </div>
    </div>
    <div class="why__cards">
      {items.map((it, i) => (
        <article class="why__card" data-reveal style={`--d:${i}`}>
          <div class="icon-badge icon-badge--night"><Icon name={it.icon} size={26} /></div>
          <h3 class="h3">{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .why__glow {
    position: absolute;
    width: 700px;
    height: 700px;
    right: -200px;
    top: -250px;
    background: radial-gradient(circle, rgb(255 90 31 / 0.22), transparent 60%);
    pointer-events: none;
    animation: glow 12s ease-in-out infinite alternate;
  }
  @keyframes glow {
    to {
      transform: translate(-200px, 160px);
    }
  }
  .why__grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .why__intro {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .why h2 {
    color: #fff;
  }
  .why__badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 200px;
    height: 200px;
    margin-top: 1rem;
  }
  .why__ring {
    position: absolute;
    inset: 0;
    animation: spin 22s linear infinite;
  }
  .why__ring text {
    fill: #a9b3c6;
    font-size: 12px;
    font-weight: 650;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .why__cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .why__card {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 1.6rem;
    border-radius: var(--r-lg);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition:
      transform 0.5s var(--ease-spring),
      background-color 0.3s,
      border-color 0.3s;
  }
  .why__card:nth-child(even) {
    translate: 0 2rem;
  }
  .why__card h3 {
    color: #fff;
  }
  .why__card p {
    color: #a9b3c6;
  }
  .why__card:hover {
    transform: translateY(-6px);
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(255 90 31 / 0.4);
  }
  .why__card:hover .icon-badge {
    background: var(--brand);
    color: #fff;
    transform: rotate(-8deg) scale(1.06);
  }
  .why__badge:not(.in-view) .why__ring {
    animation-play-state: paused;
  }
  @media (max-width: 960px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
    .why__badge {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .why__cards {
      grid-template-columns: 1fr;
    }
    .why__card:nth-child(even) {
      translate: none;
    }
  }
</style>

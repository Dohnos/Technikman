---
import { withBase } from '../lib/paths';
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="container crumbs" aria-label="Drobečková navigace">
  <ol>
    <li><a href={withBase('/')}>Úvod</a></li>
    {items.map((it) => (
      <li>{it.href ? <a href={withBase(it.href)}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 1rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--line-2);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>

---
import Icon from './Icon.astro';
import { services, site, formatPrice } from '../data/site';
import { booking } from '../data/booking';

interface Props {
  city?: string;
}
const { city = '' } = Astro.props;

const useEmbed = booking.provider === 'embed' && booking.embedUrl;
const config = JSON.stringify({
  workdays: booking.workdays,
  slots: booking.slots,
  closed: booking.closed,
  taken: booking.taken,
  daysAhead: booking.daysAhead,
  minNoticeHours: booking.minNoticeHours,
  endpoint: booking.endpoint,
  email: site.email,
});
const weekdays = ['Po', 'Út', 'St', 'Čt', 'Pá', 'So', 'Ne'];
---

<section class="section panel" id="rezervace">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="label"><Icon name="clock" size={16} /> Rezervace</span>
      <h2 class="h2">Vyberte si termín</h2>
      <p class="lead">Zvolte službu, den a čas. {booking.confirmText}</p>
    </div>

    {useEmbed ? (
      <iframe class="booking-embed card" src={booking.embedUrl} title="Rezervace termínu" loading="lazy"></iframe>
    ) : (
      <form class="booking card" data-reveal data-booking data-config={config} novalidate>
        <div class="booking__col">
          <fieldset class="step">
            <legend><span>1</span> Služba</legend>
            <div class="services-pick">
              {services.map((s) => (
                <label class="pick">
                  <input type="radio" name="sluzba" value={s.name} data-id={s.id} checked={s.main} required />
                  <span class="pick__name">{s.name}</span>
                  <span class="pick__price">{s.priceFrom ? 'od ' : ''}{formatPrice(s.price)}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="step">
            <legend><span>2</span> Den</legend>
            <div class="cal">
              <div class="cal__head">
                <button type="button" class="cal__nav" data-cal-prev aria-label="Předchozí měsíc"><Icon name="arrow" size={18} class="flip" /></button>
                <p class="cal__month" data-cal-month aria-live="polite"></p>
                <button type="button" class="cal__nav" data-cal-next aria-label="Další měsíc"><Icon name="arrow" size={18} /></button>
              </div>
              <div class="cal__grid cal__weekdays" aria-hidden="true">
                {weekdays.map((d) => <span>{d}</span>)}
              </div>
              <div class="cal__grid" data-cal-days></div>
            </div>
          </fieldset>
        </div>

        <div class="booking__col">
          <fieldset class="step">
            <legend><span>3</span> Čas</legend>
            <div class="slots" data-slots>
              <p class="hint">Nejdřív vyberte den v kalendáři.</p>
            </div>
          </fieldset>

          <fieldset class="step">
            <legend><span>4</span> Kontakt</legend>
            <div class="fields">
              <label class="field">
                <span>Jméno</span>
                <input name="jmeno" autocomplete="name" required />
              </label>
              <label class="field">
                <span>Telefon</span>
                <input name="telefon" type="tel" autocomplete="tel" required />
              </label>
              <label class="field field--full">
                <span>E-mail <small>(pro protokol)</small></span>
                <input name="email" type="email" autocomplete="email" />
              </label>
              <label class="field field--full">
                <span>Odkaz na inzerát</span>
                <input name="inzerat" type="url" inputmode="url" placeholder="https://" />
              </label>
              <label class="field field--full">
                <span>Kde auto stojí</span>
                <input name="lokalita" value={city} placeholder="Obec nebo adresa" />
              </label>
              <label class="field field--full">
                <span>Poznámka <small>(nepovinné)</small></span>
                <textarea name="poznamka" rows="2"></textarea>
              </label>
              <label class="hp" aria-hidden="true">Nevyplňovat <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
            </div>
          </fieldset>

          <input type="hidden" name="den" data-field-date />
          <input type="hidden" name="cas" data-field-time />

          <div class="booking__submit">
            <p class="summary" data-summary>Vyberte den a čas.</p>
            <button class="btn btn--accent btn--lg btn--block" type="submit" data-submit disabled>Odeslat rezervaci</button>
            <p class="error" data-error hidden></p>
          </div>
        </div>

        <div class="done" data-done hidden tabindex="-1">
          <span class="badge badge--done"><Icon name="check" size={28} /></span>
          <h3 class="h2" data-done-title>Rezervace odeslána</h3>
          <p class="done__summary" data-done-summary></p>
          <p class="hint" data-done-note>{booking.confirmText}</p>
          <button type="button" class="btn btn--ghost" data-reset>Nová rezervace</button>
        </div>
      </form>
    )}
    <noscript>
      <p class="noscript">Kalendář potřebuje zapnutý JavaScript. Termín domluvíte i na <a href={site.phoneHref}>{site.phone}</a> nebo <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </noscript>
    <p class="booking__alt">Raději telefonem? Volejte <a href={site.phoneHref}>{site.phone}</a>, {site.hours}.</p>
  </div>
</section>

<style>
  .booking {
    position: relative;
    border-radius: var(--r-xl);
    background: var(--bg);
    border: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    overflow: hidden;
  }
  .booking__col {
    display: grid;
    align-content: start;
    gap: 1.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .booking__col + .booking__col {
    border-left: 1px solid var(--line);
  }
  .step {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .step legend {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    font-weight: 650;
  }
  .step legend span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
  }

  /* Služby */
  .services-pick {
    display: grid;
    gap: 0.5rem;
  }
  .pick {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--pill);
    background: var(--surface);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .pick:hover {
    border-color: var(--ink);
  }
  .pick:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .pick input {
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
    margin: 0;
  }
  .pick__name {
    font-weight: 600;
  }
  .pick__price {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  /* Kalendář */
  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .cal__month {
    font-weight: 650;
  }
  .cal__nav {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--surface);
    cursor: pointer;
  }
  .cal__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .cal__nav :global(.flip) {
    transform: rotate(180deg);
  }
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cal__weekdays span {
    text-align: center;
    font-size: 0.78rem;
    color: var(--muted);
    padding: 0.35rem 0;
  }
  .cal__grid :global(.day) {
    height: 42px;
    width: 42px;
    justify-self: center;
    display: grid;
    place-items: center;
    border: 1.5px solid transparent;
    border-radius: 50%;
    background: var(--surface);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .cal__grid :global(.day:hover:not(:disabled)) {
    border-color: var(--ink);
  }
  .cal__grid :global(.day:disabled) {
    background: transparent;
    color: #b6b3ad;
    font-weight: 400;
    cursor: default;
  }
  .cal__grid :global(.day.is-today) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cal__grid :global(.day[aria-pressed='true']) {
    background: var(--accent);
    color: #fff;
  }

  /* Časy */
  .slots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }
  .slots :global(.slot) {
    padding: 0.65rem 0;
    border: 1.5px solid var(--line);
    border-radius: var(--pill);
    background: var(--surface);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .slots :global(.slot:hover) {
    border-color: var(--ink);
  }
  .slots :global(.slot[aria-pressed='true']) {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .booking :global(.hint) {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Formulář */
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .field {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 550;
  }
  .field small {
    color: var(--muted);
    font-weight: 400;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-weight: 400;
    font-size: 1rem;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .field input:user-invalid {
    border-color: #c0392b;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .booking__submit {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .summary {
    font-weight: 600;
  }
  .error {
    color: #c0392b;
    font-size: 0.95rem;
  }

  /* Hotovo */
  .done {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    background: var(--surface);
  }
  .done :global(.badge--done) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--ok);
    color: #fff;
  }
  .done[hidden] {
    display: none;
  }
  .done__summary {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .booking-embed {
    width: 100%;
    min-height: 720px;
  }
  .booking__alt,
  .noscript {
    margin-top: 1rem;
    color: var(--muted);
  }
  .booking__alt a,
  .noscript a {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .booking {
      grid-template-columns: 1fr;
    }
    .booking__col + .booking__col {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 420px) {
    .fields {
      grid-template-columns: 1fr;
    }
    .slots {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  type Config = {
    workdays: number[];
    slots: Record<string, string[]>;
    closed: string[];
    taken: string[];
    daysAhead: number;
    minNoticeHours: number;
    endpoint: string;
    email: string;
  };

  const pad = (n: number) => String(n).padStart(2, '0');
  const ymd = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const parse = (s: string) => {
    const [y, m, d] = s.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const longDate = new Intl.DateTimeFormat('cs-CZ', { weekday: 'long', day: 'numeric', month: 'long' });
  const monthFmt = new Intl.DateTimeFormat('cs-CZ', { month: 'long', year: 'numeric' });
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  // České státní svátky (včetně Velkého pátku a Velikonočního pondělí)
  const holidayCache = new Map<number, Set<string>>();
  const holidays = (year: number) => {
    if (holidayCache.has(year)) return holidayCache.get(year)!;
    const fixed = ['01-01', '05-01', '05-08', '07-05', '07-06', '09-28', '10-28', '11-17', '12-24', '12-25', '12-26'];
    // Velikonoční neděle – anonymní gregoriánský algoritmus
    const a = year % 19, b = Math.floor(year / 100), c = year % 100;
    const d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
    const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4;
    const l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
    const month = Math.floor((h + l - 7 * m + 114) / 31), day = ((h + l - 7 * m + 114) % 31) + 1;
    const easter = new Date(year, month - 1, day);
    const shift = (n: number) => ymd(new Date(year, easter.getMonth(), easter.getDate() + n));
    const set = new Set([...fixed.map((md) => `${year}-${md}`), shift(-2), shift(1)]);
    holidayCache.set(year, set);
    return set;
  };

  document.querySelectorAll<HTMLFormElement>('[data-booking]').forEach((form) => {
    const cfg: Config = JSON.parse(form.dataset.config!);
    const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const daysEl = $('[data-cal-days]');
    const monthEl = $('[data-cal-month]');
    const prevBtn = $<HTMLButtonElement>('[data-cal-prev]');
    const nextBtn = $<HTMLButtonElement>('[data-cal-next]');
    const slotsEl = $('[data-slots]');
    const summaryEl = $('[data-summary]');
    const submitBtn = $<HTMLButtonElement>('[data-submit]');
    const errorEl = $('[data-error]');
    const doneEl = $('[data-done]');
    const dateField = $<HTMLInputElement>('[data-field-date]');
    const timeField = $<HTMLInputElement>('[data-field-time]');

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const lastDay = new Date(today);
    lastDay.setDate(lastDay.getDate() + cfg.daysAhead);
    const taken = new Set(cfg.taken);
    const closed = new Set(cfg.closed);

    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    let selDate = '';
    let selTime = '';

    const slotsFor = (key: string) => {
      const d = parse(key);
      if (d < today || d > lastDay) return [];
      if (!cfg.workdays.includes(d.getDay())) return [];
      if (closed.has(key) || holidays(d.getFullYear()).has(key)) return [];
      const earliest = Date.now() + cfg.minNoticeHours * 3600_000;
      return (cfg.slots[d.getDay()] ?? cfg.slots.default ?? []).filter((t) => {
        if (taken.has(`${key} ${t}`)) return false;
        const [hh, mm] = t.split(':').map(Number);
        return new Date(d.getFullYear(), d.getMonth(), d.getDate(), hh, mm).getTime() >= earliest;
      });
    };

    const serviceName = () => form.querySelector<HTMLInputElement>('input[name="sluzba"]:checked')?.value ?? '';

    const updateSummary = () => {
      dateField.value = selDate;
      timeField.value = selTime;
      if (selDate && selTime) {
        summaryEl.textContent = `${serviceName()} · ${longDate.format(parse(selDate))} · ${selTime}`;
      } else if (selDate) {
        summaryEl.textContent = `${cap(longDate.format(parse(selDate)))} – vyberte čas.`;
      } else {
        summaryEl.textContent = 'Vyberte den a čas.';
      }
      submitBtn.disabled = !(selDate && selTime);
    };

    const renderSlots = () => {
      slotsEl.replaceChildren();
      if (!selDate) {
        slotsEl.innerHTML = '<p class="hint">Nejdřív vyberte den v kalendáři.</p>';
        return;
      }
      for (const t of slotsFor(selDate)) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'slot';
        b.textContent = t;
        b.setAttribute('aria-pressed', String(t === selTime));
        b.addEventListener('click', () => {
          selTime = t;
          renderSlots();
          updateSummary();
        });
        slotsEl.append(b);
      }
    };

    const renderCalendar = () => {
      monthEl.textContent = cap(monthFmt.format(view));
      daysEl.replaceChildren();
      const offset = (view.getDay() + 6) % 7;
      for (let i = 0; i < offset; i++) daysEl.append(document.createElement('span'));
      const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= days; n++) {
        const d = new Date(view.getFullYear(), view.getMonth(), n);
        const key = ymd(d);
        const free = slotsFor(key).length > 0;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'day';
        b.textContent = String(n);
        b.disabled = !free;
        b.classList.toggle('is-today', key === ymd(today));
        b.setAttribute('aria-label', `${longDate.format(d)}${free ? '' : ' – nedostupné'}`);
        b.setAttribute('aria-pressed', String(key === selDate));
        b.addEventListener('click', () => {
          selDate = key;
          selTime = '';
          renderCalendar();
          renderSlots();
          updateSummary();
        });
        daysEl.append(b);
      }
      prevBtn.disabled = view <= new Date(today.getFullYear(), today.getMonth(), 1);
      nextBtn.disabled = new Date(view.getFullYear(), view.getMonth() + 1, 1) > lastDay;
    };

    prevBtn.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      renderCalendar();
    });
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'sluzba') updateSummary();
    });

    // Tlačítka „Rezervovat“ u služeb předvyberou službu
    document.querySelectorAll<HTMLElement>('[data-book]').forEach((a) =>
      a.addEventListener('click', () => {
        const input = form.querySelector<HTMLInputElement>(`input[data-id="${a.dataset.book}"]`);
        if (input) {
          input.checked = true;
          updateSummary();
        }
      }),
    );

    const finish = (note?: string, title?: string) => {
      $('[data-done-summary]').textContent = summaryEl.textContent;
      if (note) $('[data-done-note]').textContent = note;
      if (title) $('[data-done-title]').textContent = title;
      doneEl.hidden = false;
      doneEl.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      if (!selDate || !selTime) return;
      // pole kontaktu musí být vyplněná
      const required = [...form.querySelectorAll<HTMLInputElement>('.fields [required]')];
      const invalid = required.find((el) => !el.checkValidity());
      if (invalid) {
        invalid.reportValidity();
        return;
      }
      const data = new FormData(form);
      if (String(data.get('_gotcha') ?? '')) return;
      data.set('termin', `${longDate.format(parse(selDate))} ${selTime}`);

      if (cfg.endpoint) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Odesílám…';
        try {
          const res = await fetch(cfg.endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          finish();
        } catch {
          errorEl.textContent = 'Odeslání se nepovedlo. Zkuste to prosím znovu, nebo zavolejte.';
          errorEl.hidden = false;
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Odeslat rezervaci';
        }
        return;
      }

      // Bez backendu: předvyplněný e-mail
      const g = (k: string) => String(data.get(k) ?? '').trim();
      const subject = `Rezervace: ${g('sluzba')} – ${g('termin')}`;
      const body = [
        `Služba: ${g('sluzba')}`,
        `Termín: ${g('termin')}`,
        `Jméno: ${g('jmeno')}`,
        `Telefon: ${g('telefon')}`,
        `E-mail: ${g('email')}`,
        `Inzerát: ${g('inzerat')}`,
        `Kde auto stojí: ${g('lokalita')}`,
        '',
        g('poznamka'),
      ].join('\n');
      window.location.href = `mailto:${cfg.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      finish('Otevřel se vám e-mail s vyplněnou rezervací. Odešlete ho a termín potvrdím telefonicky.', 'Ještě odeslat e-mail');
    });

    $('[data-reset]').addEventListener('click', () => {
      doneEl.hidden = true;
      selDate = '';
      selTime = '';
      renderCalendar();
      renderSlots();
      updateSummary();
    });

    // Zobraz měsíc s prvním volným dnem
    const first = new Date(today);
    while (first <= lastDay && slotsFor(ymd(first)).length === 0) first.setDate(first.getDate() + 1);
    if (first <= lastDay) view = new Date(first.getFullYear(), first.getMonth(), 1);
    renderCalendar();
    updateSummary();
  });
</script>

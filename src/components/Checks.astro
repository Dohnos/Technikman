---
import Icon from './Icon.astro';
import { checks, site } from '../data/site';
---

<section class="section section--white checks" id="co-kontrolujeme">
  <div class="container checks__grid">
    <div class="checks__aside">
      <div class="checks__sticky" data-reveal="left">
        <span class="eyebrow">Co kontrolujeme</span>
        <h2 class="h2">Auto projdeme <span class="hl">bod po bodu.</span></h2>
        <p class="lead">Žádné „kopnu do gumy a je to dobrý“. Postupujeme podle kontrolního seznamu a každý nález vyfotíme.</p>
        <div class="checks__counter">
          <span class="checks__num">{site.checkpoints}</span>
          <span>kontrolních bodů<br />při každé prověrce</span>
        </div>
        <ul class="checks__tools">
          <li><Icon name="layers" size={18} />Tloušťkoměr laku</li>
          <li><Icon name="cpu" size={18} />Profesionální diagnostika</li>
          <li><Icon name="history" size={18} />Databáze historie vozidel</li>
        </ul>
      </div>
    </div>
    <div class="checks__list">
      {checks.map((c, i) => (
        <article class="check" data-reveal style={`--d:${i % 2}`}>
          <div class="icon-badge"><Icon name={c.icon} size={26} /></div>
          <div>
            <h3 class="h3">{c.title}</h3>
            <p>{c.text}</p>
          </div>
          <span class="check__num">{String(i + 1).padStart(2, '0')}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .checks {
    border-radius: var(--r-xl);
  }
  .checks__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .checks__sticky {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .checks__counter {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.4rem 1rem 1rem;
    border-radius: var(--r);
    background: var(--ink);
    color: #cfd6e4;
    line-height: 1.3;
  }
  .checks__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    letter-spacing: -0.04em;
    color: #fff;
    padding: 0.2rem 0.8rem;
    border-radius: 14px;
    background: var(--brand);
  }
  .checks__tools {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .checks__tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--pill);
    background: var(--paper);
    font-size: 0.92rem;
    font-weight: 550;
  }
  .checks__tools .icon {
    color: var(--brand);
  }
  .checks__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .check {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid transparent;
    transition:
      transform 0.5s var(--ease-spring),
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.5s var(--ease-out);
  }
  .check p {
    color: var(--muted);
    margin-top: 0.4rem;
    font-size: 0.98rem;
  }
  .check__num {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: rgb(16 24 40 / 0.14);
    transition: color 0.3s;
  }
  .check:hover {
    transform: translateY(-4px);
    background: var(--surface);
    border-color: var(--line);
    box-shadow: var(--shadow);
  }
  .check:hover .icon-badge {
    background: var(--brand);
    color: #fff;
    transform: rotate(-8deg) scale(1.06);
  }
  .check:hover .check__num {
    color: var(--brand);
  }
  @media (max-width: 960px) {
    .checks__grid {
      grid-template-columns: 1fr;
    }
    .checks__sticky {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .checks__list {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Icon from './Icon.astro';
import { checks } from '../data/site';
---

<section class="section section--white" id="co-kontroluji">
  <div class="container">
    <div class="section-head">
      <p class="label">Co kontroluji</p>
      <h2 class="h2">Celé auto, ne jen to, co je vidět</h2>
      <p class="lead">Postupuji podle kontrolního seznamu. Každý nález vyfotím a dám do protokolu.</p>
    </div>
    <ul class="checks">
      {checks.map((c, i) => (
        <li data-reveal style={`--d:${i % 4}`}>
          <Icon name={c.icon} size={24} />
          <h3 class="h3">{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ul>
    <p class="checks__tools">Vybavení: tloušťkoměr laku, profesionální diagnostika, databáze historie vozidel.</p>
  </div>
</section>

<style>
  .checks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .checks li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.4rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .checks :global(.icon) {
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .checks p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .checks__tools {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .checks {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .checks {
      grid-template-columns: 1fr;
    }
    .checks li {
      grid-template-columns: 24px 1fr;
      column-gap: 0.9rem;
      row-gap: 0.15rem;
    }
    .checks :global(.icon) {
      grid-row: span 2;
      margin: 2px 0 0;
    }
  }
</style>

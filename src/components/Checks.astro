---
import Icon from './Icon.astro';
import { checks } from '../data/site';
---

<section class="section panel" id="co-kontroluji">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="label"><Icon name="search" size={16} /> Co kontroluji</span>
      <h2 class="h2">Celé auto, ne jen to, co je vidět</h2>
      <p class="lead">Postupuji podle kontrolního seznamu. Každý nález vyfotím a dám do protokolu.</p>
    </div>
    <ul class="checks">
      {checks.map((c, i) => (
        <li data-reveal style={`--d:${i % 4}`}>
          <span class="badge"><Icon name={c.icon} size={24} /></span>
          <h3 class="h3">{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ul>
    <ul class="tools" data-reveal>
      <li><Icon name="layers" size={18} /> Tloušťkoměr laku</li>
      <li><Icon name="cpu" size={18} /> Profesionální diagnostika</li>
      <li><Icon name="history" size={18} /> Databáze historie vozidel</li>
    </ul>
  </div>
</section>

<style>
  .checks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem;
  }
  .checks li {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.4rem;
    border-radius: var(--r-lg);
    background: var(--bg);
    transition:
      transform 0.4s var(--spring),
      background-color 0.3s;
  }
  .checks li:hover {
    transform: translateY(-5px);
    background: var(--accent-soft);
  }
  .checks li:hover .badge {
    background: var(--accent);
    color: #fff;
    transform: rotate(-8deg) scale(1.05);
  }
  .checks .badge {
    margin-bottom: 0.4rem;
    background: var(--surface);
  }
  .checks p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .tools {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--pill);
    border: 1px solid var(--line);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .tools :global(.icon) {
    color: var(--accent);
  }
  @media (max-width: 960px) {
    .checks {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .checks {
      grid-template-columns: 1fr;
    }
    .checks li {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.1rem;
    }
    .checks .badge {
      grid-row: span 2;
      margin: 0;
    }
  }
</style>

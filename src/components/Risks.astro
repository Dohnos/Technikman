---
import Icon from './Icon.astro';
import { brands } from '../data/site';

const risks = [
  {
    icon: 'gauge',
    title: 'Stočený tachometr',
    text: 'Auto „po jednom majiteli“ s nájezdem, který neodpovídá stavu interiéru ani historii z databází.',
  },
  {
    icon: 'alert',
    title: 'Skrytá bouračka',
    text: 'Přelakované díly, tmel a nerovné spáry. Na fotkách v inzerátu je nikdy neuvidíte.',
  },
  {
    icon: 'wallet',
    title: 'Drahé závady',
    text: 'Rozvody, DPF, turbo nebo automat. Oprava za desítky tisíc přijde až po koupi.',
  },
];
---

<section class="marquee" aria-label="Prověřujeme všechny značky">
  <div class="marquee__track">
    {[0, 1].map((n) => (
      <ul aria-hidden={n === 1 ? 'true' : undefined}>
        {brands.map((b) => <li>{b}<span>✦</span></li>)}
      </ul>
    ))}
  </div>
</section>

<section class="section risks">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Proč prověrka</span>
      <h2 class="h2">Inzerát vypadá skvěle. <span class="hl">Realita bývá jiná.</span></h2>
      <p class="lead">Prodejce zná auto lépe než vy. My srovnáme šance: s přístroji, zkušeností a bez emocí.</p>
    </div>
    <div class="risks__grid">
      {risks.map((r, i) => (
        <article class="card risk" data-reveal style={`--d:${i}`}>
          <div class="icon-badge"><Icon name={r.icon} size={26} /></div>
          <h3 class="h3">{r.title}</h3>
          <p>{r.text}</p>
          <span class="risk__stamp"><Icon name="check" size={16} />Prověrka to odhalí</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee ul {
    display: flex;
    list-style: none;
    padding: 0;
  }
  .marquee li {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .marquee li span {
    color: var(--brand);
    font-size: 0.9rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .risks__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .risk {
    display: grid;
    gap: 1rem;
    align-content: start;
    transition:
      transform 0.5s var(--ease-spring),
      box-shadow 0.5s var(--ease-out);
  }
  .risk:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .risk:hover .icon-badge {
    transform: rotate(-8deg) scale(1.08);
    background: var(--brand);
    color: #fff;
  }
  .risk p {
    color: var(--muted);
  }
  .risk__stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    padding: 0.35rem 0.75rem;
    border-radius: var(--pill);
    background: var(--ok-50);
    color: var(--ok-600);
    font-weight: 650;
    font-size: 0.88rem;
  }
  @media (max-width: 860px) {
    .risks__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

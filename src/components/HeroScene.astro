---
import Icon from './Icon.astro';
// Ilustrace: technik s tabletem „proklepává“ auto, skenovací paprsek odhaluje kontrolní body.
const points = [
  { x: 128, y: 200, label: 'Brzdy', w: 74 },
  { x: 236, y: 112, label: 'Lak 118 µm', w: 106 },
  { x: 352, y: 158, label: 'OBD 0 chyb', w: 104 },
  { x: 452, y: 146, label: 'Motor', w: 72 },
];
const sweep = 2.8; // s – doba průjezdu paprsku
---

<div class="scene" data-scene aria-hidden="true">
  <div class="scene__bg"></div>
  <svg class="scene__svg" viewBox="0 0 600 480" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="beam" x1="0" x2="1">
        <stop offset="0" stop-color="#FF5A1F" stop-opacity="0"></stop>
        <stop offset="0.75" stop-color="#FF5A1F" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#FF5A1F" stop-opacity="0.9"></stop>
      </linearGradient>
      <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFFFFF"></stop>
        <stop offset="1" stop-color="#E9E5DC"></stop>
      </linearGradient>
      <clipPath id="carClip">
        <path id="carShape" d="M40 190V162q2-22 30-27l70-7 50-40q15-12 40-14h110q25 0 42 16l43 38 45 8q25 6 28 29v25q0 10-10 10h-38a42 42 0 0 0-84 0H170a42 42 0 0 0-84 0H50q-10 0-10-10Z"></path>
      </clipPath>
    </defs>

    <!-- radar kruhy -->
    <g class="scene__rings" fill="none" stroke="#101828" stroke-opacity="0.07">
      <circle cx="300" cy="250" r="120"></circle>
      <circle cx="300" cy="250" r="190"></circle>
      <circle cx="300" cy="250" r="260"></circle>
    </g>

    <!-- silnice -->
    <ellipse cx="250" cy="404" rx="230" ry="14" fill="#101828" opacity="0.08"></ellipse>
    <g class="scene__road" stroke="#101828" stroke-opacity="0.18" stroke-width="4" stroke-linecap="round">
      <path d="M20 432h40M100 432h40M180 432h40M260 432h40M340 432h40M420 432h40M500 432h40M580 432h40"></path>
    </g>

    <!-- auto -->
    <g transform="translate(10 194) scale(.88)">
      <use href="#carShape" fill="url(#body)" stroke="#101828" stroke-width="5" stroke-linejoin="round"></use>
      <!-- okna -->
      <path d="M200 92q10-8 30-8h55v44H160Z" fill="#101828" opacity=".88"></path>
      <path d="M297 84h41q18 0 30 12l30 32H297Z" fill="#101828" opacity=".88"></path>
      <path d="M212 96l30-6" stroke="#fff" stroke-opacity=".35" stroke-width="5" stroke-linecap="round"></path>
      <!-- linie dveří, klika, světla -->
      <path d="M291 84v104M168 132v56" stroke="#101828" stroke-width="3" stroke-opacity=".35"></path>
      <rect x="250" y="142" width="22" height="6" rx="3" fill="#101828" opacity=".45"></rect>
      <rect x="330" y="142" width="22" height="6" rx="3" fill="#101828" opacity=".45"></rect>
      <path d="M472 146h18q6 0 6 8" stroke="#FFB020" stroke-width="8" stroke-linecap="round" fill="none"></path>
      <rect x="40" y="148" width="14" height="14" rx="5" fill="#FF5A1F"></rect>
      <path d="M60 172h420" stroke="#FF5A1F" stroke-width="6" stroke-linecap="round" opacity=".9"></path>

      <!-- skenovací paprsek -->
      <g clip-path="url(#carClip)">
        <rect class="scene__beam" x="-90" y="60" width="90" height="160" fill="url(#beam)" style={`--sweep:${sweep}s`}></rect>
      </g>

      <!-- kola -->
      {[128, 408].map((cx) => (
        <g>
          <circle cx={cx} cy="200" r="34" fill="#101828"></circle>
          <circle cx={cx} cy="200" r="17" fill="#E9E5DC"></circle>
          <path d={`M${cx} 186v28M${cx - 14} 200h28`} stroke="#101828" stroke-width="4" stroke-linecap="round"></path>
        </g>
      ))}

      <!-- kontrolní body -->
      {points.map((p) => (
        <g class="scene__point" style={`--delay:${((p.x + 90) / 610) * sweep}s; --cycle:${sweep * 2.6}s`}>
          <circle class="scene__pulse" cx={p.x} cy={p.y} r="16" fill="#17C98A"></circle>
          <circle cx={p.x} cy={p.y} r="11" fill="#17C98A" stroke="#fff" stroke-width="3"></circle>
          <path d={`M${p.x - 5} ${p.y}l3.5 3.5 6.5-7`} stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          <g transform={`translate(${p.x - p.w / 2} ${p.y - 58})`}>
            <rect width={p.w} height="32" rx="16" fill="#101828"></rect>
            <text x={p.w / 2} y="21.5" text-anchor="middle" fill="#fff" font-size="15" font-weight="650">{p.label}</text>
          </g>
        </g>
      ))}
    </g>

    <!-- technik -->
    <g class="scene__tech">
      <!-- nohy -->
      <rect x="497" y="330" width="22" height="78" rx="10" fill="#1D2939"></rect>
      <rect x="524" y="330" width="22" height="78" rx="10" fill="#1D2939"></rect>
      <rect x="486" y="398" width="34" height="14" rx="7" fill="#101828"></rect>
      <rect x="522" y="398" width="34" height="14" rx="7" fill="#101828"></rect>
      <!-- trup – pracovní bunda -->
      <path d="M488 262q0-30 34-30t34 30v78q0 6-6 6h-56q-6 0-6-6Z" fill="#FF5A1F"></path>
      <rect x="488" y="306" width="68" height="7" fill="#FFD3BF"></rect>
      <path d="M522 236v108" stroke="#E8480F" stroke-width="2"></path>
      <!-- zadní ruka -->
      <path d="M552 262l8 52" stroke="#E8480F" stroke-width="16" stroke-linecap="round"></path>
      <circle cx="560" cy="318" r="8" fill="#F1BC92"></circle>
      <!-- hlava -->
      <rect x="514" y="214" width="16" height="22" rx="6" fill="#E3A87C"></rect>
      <circle cx="522" cy="196" r="23" fill="#F1BC92"></circle>
      <path d="M499 192q0-24 25-24 22 0 23 22Z" fill="#101828"></path>
      <path d="M502 186q-14 1-18 6 6 3 20 1Z" fill="#101828"></path>
      <circle cx="509" cy="198" r="2.6" fill="#101828"></circle>
      <path d="M505 208q4 3 9 0" stroke="#101828" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
      <!-- přední ruka s tabletem -->
      <path d="M494 262l-22 34" stroke="#FF5A1F" stroke-width="16" stroke-linecap="round"></path>
      <g class="scene__tablet">
        <rect x="430" y="268" width="50" height="64" rx="9" fill="#101828" transform="rotate(-12 455 300)"></rect>
        <g transform="rotate(-12 455 300)">
          <rect x="436" y="276" width="38" height="48" rx="5" fill="#fff"></rect>
          <path d="M441 288l3 3 5-6M441 300l3 3 5-6M441 312l3 3 5-6" stroke="#17C98A" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M453 288h15M453 300h12M453 312h15" stroke="#101828" stroke-opacity=".3" stroke-width="3" stroke-linecap="round"></path>
        </g>
      </g>
      <circle cx="472" cy="298" r="8" fill="#F1BC92"></circle>
    </g>
  </svg>

  <!-- plovoucí karty -->
  <div class="float float--history">
    <div class="float__head"><span class="dot"></span>Historie tachometru</div>
    <ol class="km">
      <li><span>2019</span><b>42 100 km</b></li>
      <li><span>2021</span><b>89 400 km</b></li>
      <li><span>2024</span><b>148 200 km</b></li>
    </ol>
    <div class="float__ok"><Icon name="check" size={16} /> Nájezd sedí</div>
  </div>

  <div class="float float--verdict">
    <div class="verdict__icon"><Icon name="shield" size={22} /></div>
    <div>
      <small>Verdikt technika</small>
      <strong>Doporučujeme koupit</strong>
    </div>
  </div>

  <div class="float float--gauge">
    <svg viewBox="0 0 80 48" width="80" height="48">
      <path d="M8 44a32 32 0 0 1 64 0" fill="none" stroke="#EFEBE3" stroke-width="8" stroke-linecap="round"></path>
      <path class="gauge__val" d="M8 44a32 32 0 0 1 64 0" fill="none" stroke="#17C98A" stroke-width="8" stroke-linecap="round" pathLength="100"></path>
    </svg>
    <div><b>118 µm</b><small>originální lak</small></div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    aspect-ratio: 600 / 520;
    width: 100%;
  }
  .scene__bg {
    position: absolute;
    inset: 4% 0 0 4%;
    border-radius: var(--r-xl);
    background:
      radial-gradient(circle at 70% 30%, rgb(255 90 31 / 0.16), transparent 55%),
      radial-gradient(circle at 20% 90%, rgb(23 201 138 / 0.14), transparent 50%),
      linear-gradient(160deg, #ffffff, var(--paper-2));
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .scene__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(16 24 40 / 0.12) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
  }
  .scene__svg {
    position: absolute;
    inset: 6% 0 0 0;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene__rings circle {
    transform-origin: 300px 250px;
    animation: ring 6s ease-in-out infinite;
  }
  .scene__rings circle:nth-child(2) {
    animation-delay: -2s;
  }
  .scene__rings circle:nth-child(3) {
    animation-delay: -4s;
  }
  @keyframes ring {
    50% {
      transform: scale(1.05);
      stroke-opacity: 0.12;
    }
  }
  .scene__beam {
    animation: beam calc(var(--sweep) * 2.6) var(--ease-out) infinite;
  }
  @keyframes beam {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    38% {
      transform: translateX(610px);
      opacity: 1;
    }
    39%,
    100% {
      transform: translateX(610px);
      opacity: 0;
    }
  }
  .scene__point {
    opacity: 0;
    transform-box: fill-box;
    animation: point var(--cycle) var(--ease-spring) var(--delay) infinite;
  }
  @keyframes point {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.6);
    }
    6%,
    80% {
      opacity: 1;
      transform: none;
    }
    90%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .scene__pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 1.6s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.7);
      opacity: 0.55;
    }
    to {
      transform: scale(2);
      opacity: 0;
    }
  }
  .scene__tech {
    animation: bob 4s ease-in-out infinite;
  }
  .scene__tablet {
    transform-box: fill-box;
    transform-origin: 80% 80%;
    animation: tablet 4s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-3px);
    }
  }
  @keyframes tablet {
    50% {
      transform: rotate(-4deg);
    }
  }

  /* Floating cards */
  .float {
    position: absolute;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--r);
    box-shadow: var(--shadow-lg);
    padding: 0.9rem 1rem;
    font-size: 0.85rem;
    animation:
      float-in 0.9s var(--ease-spring) both,
      float 6s ease-in-out infinite;
  }
  .float--history {
    top: 0;
    left: -2%;
    width: 210px;
    animation-delay: 0.5s, 1.4s;
  }
  .float--verdict {
    right: -2%;
    bottom: 2%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 1.25rem;
    animation-delay: 0.9s, 0s;
  }
  .float--gauge {
    top: 10%;
    right: 2%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation-delay: 0.7s, 3s;
  }
  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.9);
    }
  }
  @keyframes float {
    50% {
      translate: 0 -10px;
    }
  }
  .float__head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 650;
    margin-bottom: 0.5rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-50);
  }
  .km {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    border-left: 2px dashed var(--line);
    padding-left: 0.75rem;
    margin-left: 3px;
  }
  .km li {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
  }
  .km b {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .float__ok {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--pill);
    background: var(--ok-50);
    color: var(--ok-600);
    font-weight: 650;
  }
  .verdict__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--ok);
    color: #fff;
  }
  .float small {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .float strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .float--gauge b {
    font-family: var(--font-display);
    font-size: 1.15rem;
    display: block;
    line-height: 1.1;
  }
  .gauge__val {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: gauge 1.6s var(--ease-out) 1.2s forwards;
  }
  @keyframes gauge {
    to {
      stroke-dashoffset: 38;
    }
  }

  /* pauza animací mimo viewport */
  .scene:not(.in-view) * {
    animation-play-state: paused !important;
  }
  :global(html:not(.js)) .scene * {
    animation-play-state: running !important;
  }

  @media (max-width: 640px) {
    .float--gauge {
      display: none;
    }
    .float--history {
      width: 180px;
      font-size: 0.78rem;
      padding: 0.7rem 0.8rem;
    }
    .float--verdict {
      padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    }
    .float strong {
      font-size: 0.95rem;
    }
  }
</style>

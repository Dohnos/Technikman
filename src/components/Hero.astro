---
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import Report from './Report.astro';
import { site, services, formatPrice } from '../data/site';

interface Props {
  label?: string;
  title?: string;
  lead?: string;
}
const {
  label = 'Nezávislý technik · Olomouc a celá Morava',
  title = 'Prověrka ojetého auta před koupí',
  lead = 'Přijedu k autu, které chcete koupit, a zkontroluji ho od historie po podvozek. Ještě ten den víte, jestli ho koupit a za kolik.',
} = Astro.props;

const minPrice = Math.min(...services.map((s) => s.price));
const facts = [
  { k: 'Cena', v: `od ${formatPrice(minPrice)}` },
  { k: 'Protokol', v: 'ještě ten den' },
  { k: 'Platba', v: 'až po prověrce' },
];
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="label">{label}</p>
      <h1 class="h1">{title}</h1>
      <p class="lead">{lead}</p>
      <div class="hero__cta">
        <a class="btn btn--accent btn--lg" href={withBase('/#rezervace')}>
          Vybrat termín <Icon name="arrow" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn--ghost btn--lg" href={site.phoneHref}>
          <Icon name="phone" size={18} /> {site.phone}
        </a>
      </div>
      <dl class="hero__facts">
        {facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="hero__visual">
      <Report />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 96px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    width: 100%;
  }
  .hero__facts div {
    padding: 0 1.5rem;
    border-left: 1px solid var(--line);
  }
  .hero__facts div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .hero__facts dt {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .hero__facts dd {
    font-weight: 600;
    margin: 0;
  }
  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .hero__cta .btn {
      width: 100%;
    }
    .hero__facts {
      grid-template-columns: repeat(3, 1fr);
      font-size: 0.92rem;
    }
    .hero__facts div {
      padding: 0 0.75rem;
    }
  }
</style>

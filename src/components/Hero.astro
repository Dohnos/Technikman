---
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import Report from './Report.astro';
import { site, services, formatPrice } from '../data/site';

interface Props {
  label?: string;
  title?: string;
  lead?: string;
}
const {
  label = 'Nezávislý technik · Olomouc a celá Morava',
  title = 'Prověrka ojetého auta před koupí',
  lead = 'Přijedu k autu, které chcete koupit, a zkontroluji ho od historie po podvozek. Ještě ten den víte, jestli ho koupit a za kolik.',
} = Astro.props;

const minPrice = Math.min(...services.map((s) => s.price));
const facts = [
  { icon: 'wallet', k: 'Cena', v: `od ${formatPrice(minPrice)}` },
  { icon: 'file', k: 'Protokol', v: 'ještě ten den' },
  { icon: 'clock', k: 'Platba', v: 'po prověrce' },
];
---

<section class="section hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="label" data-reveal><Icon name="pin" size={16} /> {label}</span>
      <h1 class="h1" data-reveal style="--d:1">{title}</h1>
      <p class="lead" data-reveal style="--d:2">{lead}</p>
      <div class="hero__cta" data-reveal style="--d:3">
        <a class="btn btn--accent btn--lg" href={withBase('/#rezervace')}>
          <Icon name="clock" size={18} /> Vybrat termín
        </a>
        <a class="btn btn--ghost btn--lg" href={site.phoneHref}>
          <Icon name="phone" size={18} /> {site.phone}
        </a>
      </div>
      <ul class="hero__facts">
        {facts.map((f, i) => (
          <li data-reveal style={`--d:${i + 4}`}>
            <span class="badge"><Icon name={f.icon} size={20} /></span>
            <span><small>{f.k}</small><b>{f.v}</b></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__visual" data-reveal="right" style="--d:2">
      <Report />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-bottom: clamp(16px, 3vw, 32px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }
  .hero__facts {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    width: 100%;
    margin-top: 0.75rem;
  }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem;
    border-radius: var(--r);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .hero__facts .badge {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }
  .hero__facts small {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.2;
  }
  .hero__facts b {
    font-size: 0.95rem;
    line-height: 1.25;
  }
  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero__cta .btn {
      width: 100%;
    }
    .hero__facts {
      grid-template-columns: 1fr;
    }
  }
</style>

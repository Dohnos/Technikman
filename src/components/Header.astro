---
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: withBase('/#co-kontrolujeme'), label: 'Co kontrolujeme' },
  { href: withBase('/#jak-to-funguje'), label: 'Jak to funguje' },
  { href: withBase('/#cenik'), label: 'Ceník' },
  { href: withBase('/#kde-pusobime'), label: 'Kde působíme' },
  { href: withBase('/#faq'), label: 'Otázky' },
];
---

<header class="header" data-header>
  <div class="header__bar container">
    <Logo />
    <nav class="header__nav" aria-label="Hlavní navigace">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        <span>{site.phone}</span>
      </a>
      <a class="btn btn--brand header__cta" href={withBase('/#objednat')}>Objednat prověrku</a>
      <button class="header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Otevřít menu" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <ul>
      {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}<Icon name="arrow" size={20} /></a></li>)}
    </ul>
    <div class="mobile-menu__cta">
      <a class="btn btn--brand btn--lg btn--block" href={withBase('/#objednat')}>Objednat prověrku</a>
      <a class="btn btn--ghost btn--lg btn--block" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 12px;
    transition: padding 0.4s var(--ease-out);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 10px 10px 10px 18px;
    border-radius: var(--pill);
    background: rgb(247 245 240 / 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid rgb(16 24 40 / 0.06);
    transition:
      box-shadow 0.4s var(--ease-out),
      background-color 0.4s;
  }
  .header.is-scrolled .header__bar {
    background: rgb(255 255 255 / 0.85);
    box-shadow: var(--shadow);
  }
  .header__nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: var(--pill);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--ink-2);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .header__nav a:hover {
    background: rgb(16 24 40 / 0.06);
    color: var(--ink);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: var(--pill);
  }
  .header__phone:hover {
    background: rgb(16 24 40 / 0.06);
  }
  .header__phone .icon {
    color: var(--brand);
  }
  .header__cta {
    padding: 0.8rem 1.25rem;
  }
  .header__toggle {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: var(--ink);
    cursor: pointer;
    position: relative;
  }
  .header__toggle span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition: transform 0.4s var(--ease-spring);
  }
  .header__toggle span:first-child {
    transform: translateY(-4px);
  }
  .header__toggle span:last-child {
    transform: translateY(4px);
  }
  .header__toggle[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }
  .header__toggle[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 84px 12px auto 12px;
    padding: 1rem;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    animation: menu-in 0.45s var(--ease-out);
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0;
  }
  .mobile-menu li {
    animation: item-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms + 60ms);
  }
  .mobile-menu a:not(.btn) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.95rem 0.75rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu a:not(.btn) .icon {
    color: var(--brand);
  }
  .mobile-menu__cta {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  @media (max-width: 1100px) {
    .header__phone span {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .header__nav,
    .header__phone,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: block;
    }
  }
  @media (min-width: 961px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
    menu.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

---
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: withBase('/#sluzby'), label: 'Služby' },
  { href: withBase('/#co-kontroluji'), label: 'Co kontroluji' },
  { href: withBase('/#jak-to-probiha'), label: 'Jak to probíhá' },
  { href: withBase('/#kde-jezdim'), label: 'Kde jezdím' },
  { href: withBase('/#otazky'), label: 'Otázky' },
];
---

<header class="header" data-header>
  <div class="header__bar container">
    <Logo />
    <nav class="header__nav" aria-label="Hlavní navigace">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--accent header__cta" href={withBase('/#rezervace')}>Rezervovat termín</a>
      <button class="header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Otevřít menu" data-menu-toggle>
        <Icon name="menu" size={22} class="i-open" />
        <Icon name="close" size={22} class="i-close" />
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <ul class="container">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li class="mobile-menu__cta">
        <a class="btn btn--accent btn--block" href={withBase('/#rezervace')}>Rezervovat termín</a>
        <a class="btn btn--ghost btn--block" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 246 243 / 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
  }
  .header__nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    padding: 0;
  }
  .header__nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .header__nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header__phone {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .header__phone:hover {
    color: var(--accent-ink);
  }
  .header__cta {
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
  }
  .header__toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: var(--surface);
    cursor: pointer;
  }
  .header__toggle :global(.i-close),
  .header__toggle[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .header__toggle[aria-expanded='true'] :global(.i-close) {
    display: block;
  }
  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding-bottom: 1rem;
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0.25rem 0 0;
  }
  .mobile-menu li:not(.mobile-menu__cta) a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .mobile-menu__cta {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  @media (max-width: 1080px) {
    .header__phone {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: grid;
    }
  }
  @media (min-width: 901px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
    menu.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

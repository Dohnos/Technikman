---
import Icon from './Icon.astro';
import { site, faqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
}
const { items = faqs } = Astro.props;
---

<section class="section panel" id="otazky">
  <div class="container faq">
    <div class="section-head" data-reveal>
      <span class="label"><Icon name="alert" size={16} /> Otázky</span>
      <h2 class="h2">Co se často ptáte</h2>
      <p class="lead">Nenašli jste odpověď? Zavolejte na <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
    <div class="faq__list">
      {items.map((f, i) => (
        <details class="qa" data-reveal style={`--d:${i % 3}`}>
          <summary>
            <h3>{f.q}</h3>
            <span class="qa__icon"><Icon name="plus" size={18} /></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .faq .lead a {
    color: var(--ink);
    font-weight: 700;
  }
  .faq__list {
    display: grid;
    gap: 0.6rem;
  }
  .qa {
    border-radius: var(--r);
    background: var(--bg);
    transition: background-color 0.25s;
  }
  .qa[open] {
    background: var(--accent-soft);
  }
  .qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa h3 {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .qa__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    transition:
      transform 0.35s var(--spring),
      background-color 0.25s,
      color 0.25s;
  }
  .qa[open] .qa__icon {
    transform: rotate(45deg);
    background: var(--accent);
    color: #fff;
  }
  .qa p {
    padding: 0 1.25rem 1.2rem;
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

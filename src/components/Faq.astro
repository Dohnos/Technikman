---
import Icon from './Icon.astro';
import { faqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
}
const { items = faqs } = Astro.props;
---

<section class="section section--white" id="otazky">
  <div class="container faq">
    <div class="section-head">
      <p class="label">Otázky</p>
      <h2 class="h2">Co se často ptáte</h2>
    </div>
    <div class="faq__list">
      {items.map((f) => (
        <details class="qa">
          <summary>
            <h3>{f.q}</h3>
            <Icon name="plus" size={20} class="qa__icon" />
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .qa {
    border-bottom: 1px solid var(--line);
  }
  .qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa h3 {
    font-family: var(--font-body);
    font-size: 1.04rem;
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .qa summary:hover h3 {
    color: var(--accent-ink);
  }
  .qa :global(.qa__icon) {
    flex-shrink: 0;
    transition: transform 0.25s var(--ease);
  }
  .qa[open] :global(.qa__icon) {
    transform: rotate(45deg);
  }
  .qa p {
    padding-bottom: 1.2rem;
    color: var(--muted);
    max-width: 40rem;
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

---
import { steps } from '../data/site';
---

<section class="section" id="jak-to-probiha">
  <div class="container">
    <div class="section-head">
      <p class="label">Jak to probíhá</p>
      <h2 class="h2">Od inzerátu k rozhodnutí za jeden den</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li data-reveal style={`--d:${i}`}>
          <span class="steps__n">{i + 1}</span>
          <h3 class="h3">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .steps li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
  }
  .steps li:first-child {
    border-top-color: var(--accent);
  }
  .steps__n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .steps p {
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

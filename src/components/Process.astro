---
import Icon from './Icon.astro';
import { steps } from '../data/site';
---

<section class="section" id="jak-to-probiha">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="label"><Icon name="route" size={16} /> Jak to probíhá</span>
      <h2 class="h2">Od inzerátu k rozhodnutí za jeden den</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="card" data-reveal style={`--d:${i}`}>
          <div class="steps__top">
            <span class:list={['badge', { 'badge--ok': i === steps.length - 1 }]}><Icon name={s.icon} size={24} /></span>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="h3">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.5rem;
  }
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 47px;
    right: -1rem;
    width: 1rem;
    height: 2px;
    background: var(--line-2);
  }
  .steps__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .steps__n {
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
    color: var(--line-2);
  }
  .badge--ok {
    background: var(--ok);
    color: #fff;
  }
  .steps p {
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps li::after {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>

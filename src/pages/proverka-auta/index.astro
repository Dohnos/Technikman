---
import Base from '../../layouts/Base.astro';
import Coverage from '../../components/Coverage.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import { pageCities, regions, travelPrice } from '../../data/regions';
import { site, formatPrice } from '../../data/site';

const siteUrl = (Astro.site ?? new URL(site.url)).href;
const grouped = Object.values(regions).map((r) => ({ region: r, cities: pageCities.filter((c) => c.region === r) }));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Proklepto', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Prověrka auta', item: new URL('/proverka-auta/', siteUrl).href },
    ],
  },
];
---

<Base
  title="Prověrka ojetého auta podle města | Proklepto"
  description="Nezávislá prověrka ojetého auta v Olomouci, Prostějově, Přerově, Šumperku, Brně, Zlíně, Ostravě a dalších městech na Moravě. Vyberte své město."
  schema={schema}
>
  <section class="section hub">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Prověrka auta podle města</span>
        <h1 class="h1">Kam za vámi <span class="hl">přijedeme.</span></h1>
        <p class="lead">Základna v Olomouci, výjezdy po celé Moravě. Vyberte město a podívejte se na cenu dopravy.</p>
      </div>
      {grouped.map((g) => g.cities.length > 0 && (
        <div class="hub__group">
          <h2 class="h3">{g.region}</h2>
          <div class="hub__grid">
            {g.cities.map((c, i) => {
              const t = travelPrice(c.distanceKm, site.freeRadiusKm, site.pricePerKm);
              return (
                <a class="hub__card" href={`/proverka-auta/${c.slug}/`} data-reveal style={`--d:${i % 4}`}>
                  <span class="icon-badge"><Icon name="pin" size={24} /></span>
                  <span class="hub__name">{c.name}</span>
                  <span class="hub__meta">{c.distanceKm === 0 ? 'Základna' : `cca ${c.distanceKm} km`} · doprava {t === 0 ? 'zdarma' : formatPrice(t)}</span>
                  <Icon name="arrow" size={20} class="hub__arrow" />
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
  <Coverage />
  <Contact />
</Base>

<style>
  .hub {
    padding-top: clamp(32px, 5vw, 64px);
  }
  .hub__group {
    margin-top: 2.5rem;
  }
  .hub__group h2 {
    margin-bottom: 1rem;
  }
  .hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .hub__card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      transform 0.5s var(--ease-spring),
      box-shadow 0.5s var(--ease-out);
  }
  .hub__card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }
  .hub__card:hover .icon-badge {
    background: var(--brand);
    color: #fff;
    transform: rotate(-8deg);
  }
  .hub__name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }
  .hub__meta {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .hub__card :global(.hub__arrow) {
    position: absolute;
    top: 1.6rem;
    right: 1.4rem;
    color: var(--brand);
    transition: transform 0.4s var(--ease-spring);
  }
  .hub__card:hover :global(.hub__arrow) {
    transform: translateX(4px);
  }
</style>

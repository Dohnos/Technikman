---
import { withBase, absUrl } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Coverage from '../../components/Coverage.astro';
import Booking from '../../components/Booking.astro';
import { pageCities, regions, travelPrice } from '../../data/regions';
import { site, formatPrice } from '../../data/site';

const origin = Astro.site ?? new URL(site.url);
const grouped = Object.values(regions).map((r) => ({ region: r, cities: pageCities.filter((c) => c.region === r) }));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Proklepto', item: absUrl('/', origin) },
      { '@type': 'ListItem', position: 2, name: 'Prověrka auta', item: absUrl('/proverka-auta/', origin) },
    ],
  },
];
---

<Base
  title="Prověrka ojetého auta podle města | Proklepto"
  description="Prověrka ojetého auta v Olomouci, Prostějově, Přerově, Šumperku, Brně, Zlíně, Ostravě a dalších městech na Moravě. Cena dopravy podle města."
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Prověrka auta' }]} />
  <section class="container hub">
    <div class="section-head">
      <p class="label">Prověrka auta podle města</p>
      <h1 class="h1">Kam jezdím</h1>
      <p class="lead">Základna je v Olomouci. U každého města vidíte vzdálenost a cenu dopravy.</p>
    </div>
    {grouped.map((g) => g.cities.length > 0 && (
      <div class="hub__group">
        <h2 class="h3">{g.region}</h2>
        <ul class="hub__list">
          {g.cities.map((c) => {
            const t = travelPrice(c.distanceKm, site.freeRadiusKm, site.pricePerKm);
            return (
              <li>
                <a href={withBase(`/proverka-auta/${c.slug}/`)}>
                  <span class="hub__name">{c.name}</span>
                  <span class="hub__meta">{c.distanceKm === 0 ? 'základna' : `${c.distanceKm} km`}</span>
                  <span class="hub__meta">{t === 0 ? 'doprava zdarma' : `doprava ${formatPrice(t)}`}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>
  <Coverage />
  <Booking />
</Base>

<style>
  .hub {
    padding-block: clamp(32px, 5vw, 56px) var(--section);
  }
  .hub__group {
    margin-top: 2rem;
  }
  .hub__group h2 {
    margin-bottom: 0.5rem;
  }
  .hub__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .hub__list a {
    display: grid;
    grid-template-columns: 1fr 8rem 10rem;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .hub__list a:hover .hub__name {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .hub__name {
    font-weight: 600;
  }
  .hub__meta {
    color: var(--muted);
    text-align: right;
  }
  @media (max-width: 560px) {
    .hub__list a {
      grid-template-columns: 1fr auto;
    }
    .hub__list a .hub__meta:nth-child(2) {
      display: none;
    }
  }
</style>

---
import { absUrl } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import GarageStage from '../../components/GarageStage.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Checks from '../../components/Checks.astro';
import Process from '../../components/Process.astro';
import Booking from '../../components/Booking.astro';
import Coverage from '../../components/Coverage.astro';
import Faq from '../../components/Faq.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { pageCities, travelPrice, type City } from '../../data/regions';
import { site, services, mainService, faqs, formatPrice } from '../../data/site';

export function getStaticPaths() {
  return pageCities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

interface Props {
  city: City;
}
const { city } = Astro.props;
const origin = Astro.site ?? new URL(site.url);
const travel = travelPrice(city.distanceKm, site.freeRadiusKm, site.pricePerKm);
const travelText = travel === 0 ? 'doprava zdarma' : `doprava cca ${formatPrice(travel)}`;
const price = mainService.price.toLocaleString('cs-CZ');

const cityFaqs = [
  {
    q: `Kolik stojí prověrka auta ${city.locative}?`,
    a:
      travel === 0
        ? `Prověrka na místě ${city.locative} stojí ${price} Kč, doprava je zdarma.`
        : `Prověrka na místě stojí ${price} Kč. Doprava z Olomouce (cca ${city.distanceKm} km) vychází zhruba na ${travel.toLocaleString('cs-CZ')} Kč. Když je v jednom dni víc aut, cenu dopravy dělím.`,
  },
  {
    q: `Jezdíte i do okolí ${city.genitive}?`,
    a: `Ano, například ${city.nearby.join(', ')}. Cena dopravy se počítá z Olomouce.`,
  },
  ...faqs.filter((f) => !f.q.startsWith('Kolik stojí') && !f.q.startsWith('Kam jezdíte')),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Prověrka ojetého auta ${city.locative}`,
    serviceType: 'Prověrka ojetého automobilu před koupí',
    provider: { '@id': `${absUrl('/', origin)}#business` },
    areaServed: { '@type': 'City', name: city.name, containedInPlace: { '@type': 'AdministrativeArea', name: city.region } },
    offers: services.map((p) => ({ '@type': 'Offer', name: p.name, price: p.price, priceCurrency: 'CZK' })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Proklepto', item: absUrl('/', origin) },
      { '@type': 'ListItem', position: 2, name: 'Prověrka auta', item: absUrl('/proverka-auta/', origin) },
      { '@type': 'ListItem', position: 3, name: city.name, item: absUrl(`/proverka-auta/${city.slug}/`, origin) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cityFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title={`Prověrka ojetého auta ${city.name} | Proklepto`}
  description={`Nezávislá prověrka ojetého auta ${city.locative} a okolí. Historie a VIN, lak, diagnostika, zkušební jízda. Prověrka na místě ${price} Kč, ${travelText}. Rezervace online.`}
  schema={schema}
>
  <GarageStage />
  <Breadcrumbs items={[{ name: 'Prověrka auta', href: '/proverka-auta/' }, { name: city.name }]} />
  <Hero
    label={`${city.region} · ${city.distanceKm === 0 ? 'základna' : `${city.distanceKm} km z Olomouce`} · ${travelText}`}
    title={`Prověrka ojetého auta ${city.locative}`}
    lead={city.intro}
  />
  <Services />
  <Checks />
  <Process />
  <Booking city={city.name} />
  <Coverage active={city.slug} />
  <Faq items={cityFaqs} />
</Base>

---
import Base from '../layouts/Base.astro';
import GarageStage from '../components/GarageStage.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Checks from '../components/Checks.astro';
import Process from '../components/Process.astro';
import Booking from '../components/Booking.astro';
import Coverage from '../components/Coverage.astro';
import Faq from '../components/Faq.astro';
import { faqs, services } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Prověrka ojetého auta Olomouc a Morava | Proklepto"
  description={`Nezávislá prověrka ojetého auta před koupí od ${services[0].price} Kč. Historie a VIN, lak, diagnostika, zkušební jízda, protokol týž den. Rezervace termínu online. Olomouc, Brno, Zlín, Ostrava.`}
  schema={[faqSchema]}
>
  <GarageStage />
  <Hero />
  <Services />
  <Checks />
  <Process />
  <Booking />
  <Coverage />
  <Faq />
</Base>

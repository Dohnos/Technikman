---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LogoMark from '../components/LogoMark.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const colors = [
  { name: 'Asfalt', hex: '#16181B', role: 'Text, tmavé plochy, logo', fg: '#fff' },
  { name: 'Papír', hex: '#F3F1EC', role: 'Pozadí stránky', fg: '#16181B' },
  { name: 'Bílá', hex: '#FFFFFF', role: 'Karty, formuláře', fg: '#16181B' },
  { name: 'Linka', hex: '#E6E2DA', role: 'Oddělovače, rámečky', fg: '#16181B' },
  { name: 'Signál', hex: '#E0531F', role: 'Akcent: hlavní tlačítko, ikony, logo', fg: '#fff' },
  { name: 'OK / Pozor', hex: '#1E8A5A · #B7791F', role: 'Jen stavy v protokolu', fg: '#fff', split: true },
];
const icons = ['history', 'layers', 'cpu', 'wrench', 'disc', 'seat', 'steering', 'file', 'phone', 'mail', 'pin', 'check'];
const rules = [
  ['Kulaté tvary', 'Vše zaoblené: karty 28 px, panely 40 px, tlačítka a štítky jako pilulka.'],
  ['Jeden akcent', 'Oranžová pro hlavní akci, ikony a logo. Zelená jen pro „v pořádku“.'],
  ['Ikony všude', 'Každá sekce, služba a krok má svou ikonu v zaobleném odznaku.'],
  ['Mechanik v 3D', 'Úvod tvoří 3D scéna: mechanik prověřuje auto podle scrollu.'],
  ['Stručně', 'Krátké věty v první osobě. „Přijedu, zkontroluji, zavolám.“'],
  ['Neslibovat', 'Píšeme jen to, co jde dodržet a ověřit.'],
];
---

<Base title="Brand manuál | Proklepto" description="Vizuální identita značky Proklepto: logo, barvy, písmo, ikony a pravidla." noindex>
  <section class="container brand">
    <div class="section-head">
      <p class="label">Brand manuál · v{site.version}</p>
      <h1 class="h1">Proklepto</h1>
      <p class="lead">Z „proklepnout“: důkladně prověřit, než se rozhodnete. Značka má působit jako dobrý technik: přátelsky, přesně a srozumitelně.</p>
    </div>

    <h2 class="h3 b-title">Logo</h2>
    <div class="b-logos">
      <div class="b-tile"><Logo size={44} /></div>
      <div class="b-tile b-tile--dark"><Logo size={44} inverse /></div>
      <div class="b-tile"><LogoMark size={96} /></div>
    </div>
    <ul class="b-notes">
      <li>Značka je písmeno „P“: bříško tvoří lupa, nožička její rukojeť. Fajfka v lupě znamená „v pořádku“.</li>
      <li>Dvě barvy: Asfalt a Signál. Na tmavém pozadí bílý čtverec.</li>
      <li>Logotyp „proklepto“ malými písmeny, Plus Jakarta Sans ExtraBold. Ochranná zóna ¼ šířky značky, minimum 24 px.</li>
    </ul>

    <h2 class="h3 b-title">Barvy</h2>
    <div class="b-colors">
      {colors.map((c) => (
        <div class="b-color">
          <div class="b-swatch" style={c.split ? 'background:linear-gradient(90deg,#1E8A5A 50%,#B7791F 50%)' : `background:${c.hex}`}></div>
          <b>{c.name}</b>
          <code>{c.hex}</code>
          <small>{c.role}</small>
        </div>
      ))}
    </div>

    <h2 class="h3 b-title">Písmo</h2>
    <div class="b-type">
      <div class="b-tile b-tile--left">
        <small>Nadpisy · Plus Jakarta Sans 800</small>
        <p class="b-type__display">Prověrka ojetého auta před koupí</p>
      </div>
      <div class="b-tile b-tile--left">
        <small>Text · Plus Jakarta Sans 400–600, 17 px</small>
        <p>Přijedu k autu, které chcete koupit, a zkontroluji ho od historie po podvozek. Ještě ten den víte, jestli ho koupit a za kolik.</p>
      </div>
    </div>

    <h2 class="h3 b-title">Ikony</h2>
    <div class="b-icons">
      {icons.map((n) => (
        <div class="b-icon"><Icon name={n} size={24} /><small>{n}</small></div>
      ))}
    </div>
    <p class="b-caption">Lineární, 24 × 24 px, tah 1,75 px. V sekcích v zaobleném odznaku 48 px (radius 16 px) se světle oranžovým podkladem.</p>

    <h2 class="h3 b-title">Prvky</h2>
    <div class="b-tile b-tile--left b-components">
      <a class="btn btn--accent" href="#">Rezervovat termín</a>
      <a class="btn" href="#">Sekundární</a>
      <a class="btn btn--ghost" href="#">Obrysové</a>
      <span class="label"><Icon name="search" size={16} /> Štítek sekce</span>
    </div>
    <p class="b-caption">Zaoblení 12 / 18 / 28 / 40 px, tlačítka a štítky jako pilulka.</p>

    <h2 class="h3 b-title">Pravidla</h2>
    <dl class="b-rules">
      {rules.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .brand {
    padding-block: clamp(40px, 6vw, 72px) var(--section);
  }
  .b-title {
    margin: 3rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .b-tile {
    display: grid;
    place-items: center;
    min-height: 160px;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
  }
  .b-tile--dark {
    background: var(--dark);
    border-color: var(--dark);
  }
  .b-tile--left {
    place-items: start;
    align-content: start;
    gap: 0.75rem;
    min-height: 0;
  }
  .b-logos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .b-notes {
    margin-top: 1rem;
    padding-left: 1.2rem;
    color: var(--ink-2);
    display: grid;
    gap: 0.35rem;
  }
  .b-colors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem 1rem;
  }
  .b-color {
    display: grid;
    gap: 0.15rem;
  }
  .b-swatch {
    height: 88px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    margin-bottom: 0.5rem;
  }
  .b-color code,
  .b-color small {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .b-type {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .b-type small {
    color: var(--muted);
  }
  .b-type__display {
    font-weight: 800;
    font-size: 2.2rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .b-icons {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.6rem;
  }
  .b-icon {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.1rem 0.5rem;
    border-radius: var(--r);
    background: var(--surface);
    color: var(--accent);
  }
  .b-icon small {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .b-caption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .b-components {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .b-rules {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
  }
  .b-rules dt {
    font-weight: 650;
  }
  .b-rules dd {
    margin: 0.2rem 0 0;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .b-logos,
    .b-colors,
    .b-rules {
      grid-template-columns: 1fr 1fr;
    }
    .b-type {
      grid-template-columns: 1fr;
    }
    .b-icons {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 460px) {
    .b-logos,
    .b-colors,
    .b-rules {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
---

<Base title="Stránka nenalezena | Proklepto" description="Tahle stránka neexistuje." noindex>
  <section class="nf container">
    <p class="label">Chyba 404</p>
    <h1 class="h1">Tahle stránka neexistuje</h1>
    <p class="lead">Odkaz je možná starý. Zkuste úvodní stránku nebo rovnou rezervaci.</p>
    <div class="nf__cta">
      <a class="btn" href={withBase('/')}>Úvodní stránka</a>
      <a class="btn btn--ghost" href={withBase('/#rezervace')}>Rezervovat termín</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(64px, 12vw, 140px);
  }
  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
</style>
